# Zeilenenden vereinheitlichen.
# Standard: Git entscheidet anhand Inhalt.
* text=auto

# Dateien, die auf den Raspberry Pis (Linux) ausgeführt/eingelesen werden,
# MÜSSEN LF behalten — CRLF bricht Shell-Skripte, systemd-Units und Configs.
*.sh        text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ino       text eol=lf
wpa_supplicant* text eol=lf

# Markdown/Doku: auf Windows bearbeitet -> CRLF lokal ok
*.md        text
